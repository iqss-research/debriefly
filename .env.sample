# -------------- Azure OpenAI -------------- #
# Get these values from https://oai.azure.com/resource/deployments
AZURE_OPENAI_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_DEPLOYMENT_MODEL=gpt-4o-mini
AZURE_OPENAI_ENDPOINT=https://cognitivedebriefing.openai.azure.com/openai/deployments/gpt-4o-mini/chat/completions?api-version=2023-03-15-preview

# Create using Azure Portal -> Azure AI Services -> AI Search
# Get endpoint from <Resource> -> Overview -> Url
AZURE_OPENAI_SEARCH_ENDPOINT = https://ai-search-cognitivedebriefing.search.windows.net
# Get key from <Resource> -> Settings -> Keys
AZURE_OPENAI_SEARCH_KEY = XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# -------------- Azure OpenAI -------------- #
