# ----------- OpenAI Integration ----------- #

# -------------- Azure OpenAI -------------- #
# If using Azure OpenAI, get these values from https://oai.azure.com/resource/deployments
# Fill out all values, even if some seem redundant
# This will take precedence over OpenAI values
AZURE_OPENAI_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
AZURE_OPENAI_API_VERSION=YYYY-MM-DD-preview
AZURE_OPENAI_DEPLOYMENT_MODEL=deployment-model-name
AZURE_OPENAI_ENDPOINT=https://your-azure-openai-endpoint.com/path?api-version=YYYY-MM-DD-preview
# -------------- Azure OpenAI -------------- #

# -------------- OpenAI -------------- #
# If using OpenAI directly, get these values from https://platform.openai.com/api-keys
# Fill out all values, even if some seem redundant
OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
OPENAI_ORG_ID=org-XXXXXXXXXXXXXXXXX
OPENAI_PROJECT_ID=proj_XXXXXXXXXXXXXXXXXXXXXXXXXX
# -------------- OpenAI -------------- #

# ----------- OpenAI Integration ----------- #

