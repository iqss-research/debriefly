# Copy this file to .env. Never commit the resulting .env file.

# -------- Local authentication --------
# Generate with: openssl rand -hex 32
AUTH_SECRET_KEY=replace-with-at-least-32-random-characters

# Browser-facing frontend URL. Production must use HTTPS.
AUTH_PUBLIC_URL=http://localhost:3000

# Leave empty when /_event is proxied to the backend on the same public origin.
# Local Reflex development normally needs the explicit backend URL below.
AUTH_API_PUBLIC_URL=http://localhost:8000

# Exact origins permitted to submit auth forms and open authenticated sockets.
AUTH_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local HTTP development only. Production HTTPS defaults to a Secure __Host- cookie.
AUTH_COOKIE_SECURE=false
AUTH_ALLOW_REGISTRATION=true
AUTH_SESSION_HOURS=168
AUTH_TOKEN_HOURS=48
# Limit Argon2 memory use per backend process (2 × roughly 64 MiB by default).
AUTH_PASSWORD_HASH_CONCURRENCY=2

# SMTP is required for self-service verification, migrated-account setup,
# password reset, and feedback notifications. Without it, account emails and
# feedback delivery are unavailable.
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM=Debriefly <no-reply@example.org>

# -------- Database (optional locally; production requires PostgreSQL) --------
# DB_URL=postgresql://user:password@host/database
# Existing deployments may instead supply all four legacy variables:
# DB_USER=user
# DB_PASS=password
# DB_NAME=debriefly
# DB_HOST=postgresql

# -------- OpenAI --------
# Researchers configure their own standard OpenAI API key in the application.
OPENAI_MODEL=gpt-4o-mini
